# --- required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Protects /pair and /status. Without it those endpoints are disabled and you
# must pair from the logs. Generate one: openssl rand -hex 32
ADMIN_TOKEN=

# --- pairing ----------------------------------------------------------------
# Your number in international format, digits only. Set it to log in with an
# 8-character pairing code (much easier on a server) instead of a QR scan.
PAIRING_NUMBER=

# --- model ------------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Chat replies are short; low is plenty.
CLAUDE_EFFORT=low
# Thinking tokens count towards this, so don't set it too tight — the reply
# itself is kept short by the system prompt, not by this ceiling.
CLAUDE_MAX_TOKENS=2048
# Either inline, or point SYSTEM_PROMPT_FILE at a file. Leave both unset to use
# the built-in assistant persona in src/config.ts.
# SYSTEM_PROMPT=
# SYSTEM_PROMPT_FILE=/data/prompt.txt

# --- who gets a reply -------------------------------------------------------
BOT_ENABLED=true
REPLY_TO_GROUPS=false
GROUP_REQUIRES_MENTION=true
# Comma-separated numbers, digits only. If ALLOWLIST is non-empty, ONLY those
# numbers get replies — the safest way to trial the bot.
ALLOWLIST=
BLOCKLIST=

# --- rails ------------------------------------------------------------------
# Never answer a message older than this (stops a reconnect backlog flood).
MAX_MESSAGE_AGE_SECONDS=180
# After you type in a chat, the bot stays quiet there this long.
TAKEOVER_MINUTES=30
CHAT_COOLDOWN_SECONDS=8
MAX_REPLIES_PER_CHAT_PER_DAY=40
MAX_REPLIES_PER_HOUR_GLOBAL=60

# --- feel -------------------------------------------------------------------
HISTORY_TURNS=12
MIN_TYPING_MS=1200
MAX_TYPING_MS=4000
MARK_READ=true

# --- ops --------------------------------------------------------------------
DATA_DIR=./data
PORT=8080
LOG_LEVEL=info
