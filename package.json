{
  "name": "wa-autoreply",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-powered WhatsApp auto-reply bot (Baileys transport)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
